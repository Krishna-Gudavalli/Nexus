# 🧠 NEXUS AI Gateway
# Choose one primary: openai | gemini | anthropic | openrouter | ollama | omniroute
AI_PROVIDER=omniroute
# Comma-separated failover chain. Example: gemini,openrouter,ollama
AI_FALLBACK_PROVIDERS=gemini,openrouter,ollama
AI_MODEL_ROUTING=true
# Maximum generated output tokens sent to OpenAI-compatible providers (including OmniRoute).
# 2048 is a safe default for cost-controlled testing.
NEXUS_MAX_OUTPUT_TOKENS=2048

# 🔀 OmniRoute (OpenAI-compatible local gateway)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# 🤖 OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ♊ Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# 🧠 Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 🌐 OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# 🦙 Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# 🐙 GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# 🌐 Optional
TAVILY_API_KEY=

# 🗄️ Optional production persistence
DATABASE_URL=

# 🧪 Optional Docker smoke sandbox
NEXUS_SANDBOX_DOCKER=false

NEXT_PUBLIC_APP_NAME=NEXUS
